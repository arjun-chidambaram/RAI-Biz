# RAI-Biz Platform Configuration

# Database
DATABASE_URL=sqlite:///./rai_biz.db

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ENVIRONMENT=development

# SMTP Email Delivery (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
EMAIL_FROM="RAI-Biz Governance <your-email@gmail.com>"

# Optional AI Features
GEMINI_API_KEY=
